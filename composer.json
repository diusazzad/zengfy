{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "laravel/framework": "^11.31",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.9",
        "nwidart/laravel-modules": "^12.0",
        "spatie/laravel-sitemap": "^7.0",
        "stevebauman/location": "^7.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\School\\": "Modules/School/app/",
            "Modules\\School\\Database\\Factories\\": "Modules/School/database/factories/",
            "Modules\\School\\Database\\Seeders\\": "Modules/School/database/seeders/",
            "Modules\\Auth\\": "Modules/Auth/app/",
            "Modules\\Auth\\Database\\Factories\\": "Modules/Auth/database/factories/",
            "Modules\\Auth\\Database\\Seeders\\": "Modules/Auth/database/seeders/",
            "Modules\\Organization\\": "Modules/Organization/app/",
            "Modules\\Organization\\Database\\Factories\\": "Modules/Organization/database/factories/",
            "Modules\\Organization\\Database\\Seeders\\": "Modules/Organization/database/seeders/",
            "Modules\\Social\\": "Modules/Social/app/",
            "Modules\\Social\\Database\\Factories\\": "Modules/Social/database/factories/",
            "Modules\\Social\\Database\\Seeders\\": "Modules/Social/database/seeders/",
            "Modules\\Landing\\": "Modules/Landing/app/",
            "Modules\\Landing\\Database\\Seeders\\": "Modules/Landing/database/seeders/",
            "Modules\\POS\\": "Modules/POS/app/",
            "Modules\\POS\\Database\\Factories\\": "Modules/POS/database/factories/",
            "Modules\\POS\\Database\\Seeders\\": "Modules/POS/database/seeders/",
            "Modules\\Law\\": "Modules/Law/app/",
            "Modules\\Law\\Database\\Factories\\": "Modules/Law/database/factories/",
            "Modules\\Law\\Database\\Seeders\\": "Modules/Law/database/seeders/",
            "Modules\\Civil\\": "Modules/Civil/app/",
            "Modules\\Civil\\Database\\Factories\\": "Modules/Civil/database/factories/",
            "Modules\\Civil\\Database\\Seeders\\": "Modules/Civil/database/seeders/",
            "Modules\\NGO\\": "Modules/NGO/app/",
            "Modules\\NGO\\Database\\Factories\\": "Modules/NGO/database/factories/",
            "Modules\\NGO\\Database\\Seeders\\": "Modules/NGO/database/seeders/",
            "Modules\\Rent\\": "Modules/Rent/app/",
            "Modules\\Rent\\Database\\Factories\\": "Modules/Rent/database/factories/",
            "Modules\\Rent\\Database\\Seeders\\": "Modules/Rent/database/seeders/",
            "Modules\\Hotel\\": "Modules/Hotel/app/",
            "Modules\\Hotel\\Database\\Factories\\": "Modules/Hotel/database/factories/",
            "Modules\\Hotel\\Database\\Seeders\\": "Modules/Hotel/database/seeders/",
            "Modules\\Shop\\": "Modules/Shop/app/",
            "Modules\\Shop\\Database\\Factories\\": "Modules/Shop/database/factories/",
            "Modules\\Shop\\Database\\Seeders\\": "Modules/Shop/database/seeders/",
            "Modules\\Ecommerce\\": "Modules/Ecommerce/app/",
            "Modules\\Skill\\": "Modules/Skill/app/",
            "Modules\\Skill\\Database\\Factories\\": "Modules/Skill/database/factories/",
            "Modules\\Skill\\Database\\Seeders\\": "Modules/Skill/database/seeders/",
            "Modules\\Journal\\": "Modules/Journal/app/",
            "Modules\\Journal\\Database\\Factories\\": "Modules/Journal/database/factories/",
            "Modules\\Journal\\Database\\Seeders\\": "Modules/Journal/database/seeders/",
            "Modules\\Habit\\": "Modules/Habit/app/",
            "Modules\\Schedule\\": "Modules/Schedule/app/",
            "Modules\\Accounts\\": "Modules/Accounts/app/",
            "Modules\\Accounts\\Database\\Seeders\\": "Modules/Accounts/database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}